# Switch between dev and prod by changing this one line
ENV=dev

# Dev credentials (use these for local testing)
GITHUB_APP_ID_DEV=123456
GITHUB_PRIVATE_KEY_DEV="-----BEGIN RSA PRIVATE KEY-----
-----END RSA PRIVATE KEY-----"

GITHUB_WEBHOOK_SECRET_DEV=your_webhook_secret_here

# Prod credentials
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Shared
GEMINI_API_KEY=AIzaSyYourGeminiKeyHere